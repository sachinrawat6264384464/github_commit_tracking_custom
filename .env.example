# ==============================================================================
# GitHub Commit Tracking & Repository Analytics Dashboard - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (production / local Postgres service)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./github_dashboard.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/github_dashboard

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ------------------------------------------------------------------------------
# 2. GITHUB INTEGRATION
# ------------------------------------------------------------------------------
# OPTION A: Personal Access Token (PAT) - Quickest way to get started!
# Provide a GitHub PAT (Fine-grained or classic with 'repo' / read-only repository permissions)
GITHUB_TOKEN=your_personal_access_token_here

# OPTION B: GitHub App Authentication (Recommended for organization-level deployments)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Or provide path to downloaded .pem key:
GITHUB_APP_PRIVATE_KEY_PATH=

# OPTION C: GitHub OAuth / App Client Credentials (for web flow connect & callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook Secret for HMAC SHA-256 validation (for real-time push event sync)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_key_here

# Rate Limit Buffer: sync will pause or back off if remaining calls fall below this threshold
GITHUB_API_RATE_LIMIT_BUFFER=50

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing session tokens and API auth
# Generate with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=super_secret_session_encryption_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Next.js Client-Side Environment Variables (Exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="GitPulse Analytics"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 5. CACHING & REDIS (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to true if a Redis server is available for caching metrics
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 6. DASHBOARD & SYNC PREFERENCES
# ------------------------------------------------------------------------------
DEFAULT_DATE_RANGE_DAYS=30
INCLUDE_MERGE_COMMITS_BY_DEFAULT=false
MAX_HISTORICAL_COMMITS_PER_REPO=500
AUTO_SYNC_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
